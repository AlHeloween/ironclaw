// Firecrawl Search Service Configuration for IronClaw
// ====================================================
//
// This file configures the native Firecrawl Search Service that provides:
// - Web search via Firecrawl API
// - URL scraping/context extraction
// - Code search via Sourcegraph public API
// - Hybrid mode combining local code search + Sourcegraph
//
// Config file location: ~/.ironclaw/firecrawl-search.jsonc
//
// To enable: Set up your Firecrawl instance and optionally configure
// Sourcegraph token for higher rate limits.

{
  // Service configuration
  "service": {
    // Port the service listens on (default: 3005)
    // "port": 3005,

    // Bind address (default: 127.0.0.1)
    // "bind_address": "127.0.0.1"
  },

  // Firecrawl API configuration
  "firecrawl": {
    // Firecrawl API URL
    // For local self-hosted instance: http://localhost:3002
    // For cloud API: https://api.firecrawl.dev
    // "api_url": "http://localhost:3002",

    // Firecrawl API key (only needed for cloud API)
    // Get your key from: https://firecrawl.dev
    // "api_key": ""
  },

  // Sourcegraph configuration (for code search)
  "sourcegraph": {
    // Sourcegraph public API endpoint (default: sourcegraph.com)
    // "api_url": "https://sourcegraph.com/.api/graphql",

    // Sourcegraph access token (optional, for higher rate limits)
    // Create a token at: https://sourcegraph.com/user/settings/tokens
    // "access_token": ""
  },

  // Local code search service configuration (for hybrid mode)
  "local_search": {
    // URL of the local code search service
    // This service indexes your local codebases for fast offline search
    // "url": "http://127.0.0.1:3004",

    // Enable/disable local search in hybrid mode
    // "enabled": true
  }
}
