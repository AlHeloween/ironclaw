// Local Code Search Service Configuration for IronClaw
// =====================================================
//
// This file configures the local code search service that indexes your codebases
// and provides full-text + symbol search. The service runs as a separate process
// and IronClaw detects it automatically when enabled.
//
// Config file location: ~/.ironclaw/local-code-search.jsonc
// Index storage:        ~/.ironclaw/code-search-indexes/
//
// To enable: Set "enabled": true in the service section and add at least one index.
// To disable: Set "enabled": false or remove this file.

{
  // Service configuration
  "service": {
    // Port the service listens on (default: 3004)
    // "port": 3004,

    // Bind address (default: "127.0.0.1")
    // "bind_address": "127.0.0.1",

    // Enable file watcher for automatic re-indexing (default: true)
    // "watch_enabled": true,

    // Debounce delay for file watcher in milliseconds (default: 500)
    // "watch_debounce_ms": 500
  },

  // Index configurations - add one entry per codebase you want to index
  "indexes": [
    // Example: Index the IronClaw repository itself
    // {
    //   // Unique name for this index
    //   "name": "ironclaw",
    //
    //   // Absolute path to the codebase root
    //   "path": "/path/to/ironclaw",
    //
    //   // Languages to index. Use "all" for all languages, or specify:
    //   // "rust", "typescript", "javascript", "python", "go", "java", etc.
    //   // (default: ["all"])
    //   "languages": ["all"],
    //
    //   // Glob patterns for files/dirs to explicitly include (default: all)
    //   // "include": [],
    //
    //   // Glob patterns for files/dirs to exclude (default: common build dirs)
    //   // Default excludes: target/, node_modules/, .git/, dist/, build/,
    //   // .next/, venv/, __pycache__/, *.pyc, *.so, *.dll, *.dylib, .DS_Store
    //   // "exclude": [],
    //
    //   // Enable symbol extraction (functions, classes, traits, etc.)
    //   // Supported: Rust, TypeScript, JavaScript, Python (default: true)
    //   "symbols_enabled": true,
    //
    //   // Maximum file size in bytes to index (default: 1MB)
    //   // "max_file_size": 1048576,
    //
    //   // Enable/disable this index (default: true)
    //   "enabled": true
    // }

    // Example: Index your personal projects
    // {
    //   "name": "my-projects",
    //   "path": "/home/user/projects",
    //   "languages": ["rust", "typescript", "python"],
    //   "symbols_enabled": true,
    //   "enabled": true
    // }
  ]
}
